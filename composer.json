{
    "name": "quolle/quolle-php",
    "description": "Official PHP SDK for the Quolle email API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "quolle",
        "email",
        "transactional",
        "smtp",
        "api"
    ],
    "homepage": "https://quolle.com",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Quolle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quolle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "support": {
        "source": "https://github.com/Quolle-main/quolle-php",
        "issues": "https://github.com/Quolle-main/quolle-php/issues",
        "docs": "https://quolle.com/docs"
    }
}
